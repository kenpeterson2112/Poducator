# Poducator — secrets required by the Edge Function.
#
# This file documents WHICH secrets are needed. It never contains values, and
# no file in this repo ever should: the repository is public, so anything
# committed here is published, and git history keeps it published even after a
# later removal.
#
# Set these in the Supabase dashboard (Edge Functions → Secrets) or with:
#   supabase secrets set ANTHROPIC_API_KEY=... POD_PASSPHRASE=...

# Your Anthropic API key. Lives only in the function's environment — it is
# never sent to a browser and never appears in the client bundle.
ANTHROPIC_API_KEY=

# The class passphrase learners type, e.g. ETEC523.
#
# Worth being clear-eyed about: this keeps the API KEY secret, which it does
# completely. It is not authentication — a shared passphrase gets shared. The
# thing that actually bounds a leaked passphrase is a spend limit on the
# Anthropic key, set in the Anthropic console.
POD_PASSPHRASE=
